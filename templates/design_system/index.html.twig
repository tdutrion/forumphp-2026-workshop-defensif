{% extends 'base.html.twig' %}

{% block title %}Design system · Movie Marathon{% endblock %}

{% block body %}
    <header>
        <h1 class="text-3xl font-bold">Design system</h1>
        <p class="text-ink-muted">Every component in the light and the dark theme. The tokens live in <code>assets/styles/app.css</code>.</p>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
        {% for theme, form in forms %}
            {# data-theme on a block: the tokens of that theme apply inside it, whatever the page theme. #}
            <section class="style-guide space-y-6 rounded-card bg-canvas p-4 text-ink ring-1 ring-line" data-theme="{{ theme }}" aria-label="{{ theme|capitalize }} theme">
                <h2 class="text-xl font-semibold">{{ theme|capitalize }} theme</h2>
                {{ include('design_system/_gallery.html.twig', {form: form}) }}
            </section>
        {% endfor %}
    </div>
{% endblock %}
