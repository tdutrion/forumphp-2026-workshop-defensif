{% extends 'base.html.twig' %}

{% block title %}{{ film.title }} · ScreenRoute{% endblock %}

{% block body %}
    <twig:Card class="flex flex-col gap-6 sm:flex-row">
        {% if film.posterUrl %}<img src="{{ film.posterUrl }}" alt="{{ 'film.poster_alt'|trans({'%title%': film.title}) }}" width="200" class="rounded-card">{% endif %}
        <div class="space-y-4">
            <h1 class="text-3xl font-bold">{{ film.title }}</h1>
            <ul class="space-y-1 text-sm text-ink-muted">
                {% if film.duration %}<li>{{ 'film.running_time'|trans({'%minutes%': film.duration}) }}</li>{% endif %}
                {% if film.releaseDate %}<li>{{ 'film.release'|trans({'%date%': film.releaseDate|format_date('long', locale=app.request.locale)}) }}</li>{% endif %}
                {% if film.genres %}<li>{{ 'film.genres'|trans({'%genres%': film.genres|join(', ')}) }}</li>{% endif %}
                {% if film.contentRating %}<li>{{ 'film.rating'|trans({'%rating%': film.contentRating}) }}</li>{% endif %}
            </ul>
            {% if film.synopsis %}<p id="synopsis" class="max-w-prose">{{ film.synopsis }}</p>{% endif %}
            {% if film.wikidataId %}
                {# Open data: the work of this film elsewhere (ids checked when stored). #}
                <p id="external-links" class="flex flex-wrap gap-4 text-sm">
                    <a href="https://www.wikidata.org/wiki/{{ film.wikidataId }}" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">Wikidata</a>
                    {% if film.imdbId %}<a href="https://www.imdb.com/title/{{ film.imdbId }}/" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">IMDb</a>{% endif %}
                    {% if film.tmdbId %}<a href="https://www.themoviedb.org/movie/{{ film.tmdbId }}" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">TMDB</a>{% endif %}
                </p>
            {% endif %}
            <twig:ButtonGroup aria-label="{{ 'film.actions'|trans }}">
                {{ include('seen/_button.html.twig', {slug: film.slug, seen: seen}) }}
                {{ include('unwanted/_button.html.twig', {slug: film.slug, unwanted: unwanted}) }}
            </twig:ButtonGroup>
        </div>
    </twig:Card>

    <twig:Card id="showtimes">
        <h2 class="mb-4 text-xl font-semibold">{{ 'film.showtimes.title'|trans({'%count%': cinemas|length}) }}</h2>
        {% for cinema in cinemas %}
            {# One block per cinema, closed by default: the days and times of its showtimes. #}
            <details class="group border-b border-line last:border-0">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3">
                    <span>
                        <span class="font-medium">{{ cinema.name }}</span>
                        <span class="text-sm text-ink-muted">· {{ cinema.city }}</span>
                    </span>
                    <span class="flex items-center gap-2">
                        <twig:Badge>{{ 'film.showtimes.count'|trans({'%count%': cinema.count}) }}</twig:Badge>
                        <twig:Icon name="chevron-down" class="transition-transform group-open:rotate-180" />
                    </span>
                </summary>
                <ul class="space-y-3 pb-4">
                    {% for day in cinema.days %}
                        <li data-day="{{ day.date }}" class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-4">
                            <span class="w-48 shrink-0 text-sm font-medium first-letter:uppercase">{{ day.date|format_date(pattern: 'EEEE d MMMM', locale=app.request.locale) }}</span>
                            <span class="flex flex-wrap gap-2">
                                {% for showtime in day.showtimes %}
                                    <a href="{{ showtime.bookingUrl }}" data-time="{{ showtime.time }}" target="_blank" rel="noopener noreferrer"
                                       class="inline-flex items-center gap-1.5 rounded-control px-2.5 py-1 text-sm font-medium ring-1 ring-line hover:bg-surface-muted hover:text-brand-700"
                                       title="{{ 'film.showtimes.book'|trans({'%time%': showtime.time}) }}">
                                        {{ showtime.time }}<span class="text-xs text-ink-muted">{{ showtime.version|upper }}</span>
                                    </a>
                                {% endfor %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% else %}
            <p class="text-ink-muted">{{ 'film.showtimes.none'|trans }}</p>
        {% endfor %}
    </twig:Card>
{% endblock %}
