{% extends 'base.html.twig' %}

{% block title %}{{ 'layout.settings'|trans }} · ScreenRoute{% endblock %}

{% block body %}
    <header>
        <h1 class="text-3xl font-bold">{{ 'layout.settings'|trans }}</h1>
        <p class="text-ink-muted">{{ user.displayName }}{% if user.email %} · {{ user.email }}{% endif %}</p>
    </header>

    <twig:Card id="theme">
        <h2 class="mb-4 text-xl font-semibold">{{ 'settings.theme'|trans }}</h2>
        <form method="post" action="{{ path('app_settings_theme') }}" class="flex flex-wrap items-end gap-4">
            <input type="hidden" name="_token" value="{{ csrf_token('settings-theme') }}">
            <fieldset class="flex flex-wrap gap-4">
                <legend class="sr-only">{{ 'settings.theme'|trans }}</legend>
                {% for choice in ['auto', 'light', 'dark'] %}
                    <label class="inline-flex items-center gap-2">
                        <input type="radio" name="theme" value="{{ choice }}" class="accent-brand-600"{% if user.theme.value == choice %} checked{% endif %}>
                        {{ ('settings.theme.' ~ choice)|trans }}
                    </label>
                {% endfor %}
            </fieldset>
            <twig:Button type="submit" size="sm">{{ 'settings.save'|trans }}</twig:Button>
        </form>
    </twig:Card>

    <twig:Card id="page-size">
        <h2 class="mb-4 text-xl font-semibold">{{ 'settings.page_size'|trans }}</h2>
        <form method="post" action="{{ path('app_settings_page_size') }}" class="flex flex-wrap items-end gap-4">
            <input type="hidden" name="_token" value="{{ csrf_token('settings-page-size') }}">
            <div class="grid gap-1">
                <label for="page-size-select" class="text-sm font-medium">{{ 'settings.page_size.label'|trans }}</label>
                <select id="page-size-select" name="pageSize" class="rounded-control border border-line bg-surface px-3 py-2 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/30">
                    {% for size in pageSizes %}
                        <option value="{{ size }}"{% if user.pageSize == size %} selected{% endif %}>{{ size }}</option>
                    {% endfor %}
                </select>
            </div>
            <twig:Button type="submit" size="sm">{{ 'settings.save'|trans }}</twig:Button>
        </form>
    </twig:Card>

    <twig:Card id="excluded-cinemas">
        <h2 class="mb-4 text-xl font-semibold">{{ 'settings.excluded_cinemas'|trans }}</h2>
        {% for cinema in excludedCinemas %}
            <div class="flex items-center justify-between gap-4 border-b border-line py-2 last:border-0">
                <span class="font-medium">{{ cinema.name }}</span>
                {{ include('excluded/_button.html.twig', {slug: cinema.slug, excluded: true}) }}
            </div>
        {% else %}
            <p class="text-ink-muted">{{ 'settings.no_cinema'|trans }}</p>
        {% endfor %}
    </twig:Card>

    <twig:Card id="connections">
        <h2 class="mb-4 text-xl font-semibold">{{ 'settings.connections'|trans }}</h2>
        <ul class="mb-4">
            {% for linkedAccount in user.linkedAccounts %}
                <li class="flex items-center justify-between gap-4 border-b border-line py-2 last:border-0">
                    <span>{{ linkedAccount.provider }}{% if linkedAccount.email %} <span class="text-ink-muted">({{ linkedAccount.email }})</span>{% endif %}</span>
                    <form method="post" action="{{ path('app_settings_connection_remove', {id: linkedAccount.id.toRfc4122}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('profile-connection') }}">
                        <twig:Button type="submit" variant="secondary" size="sm">{{ 'settings.remove_connection'|trans }}</twig:Button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        <div class="flex flex-wrap gap-2">
            {% for provider in providersToLink %}
                <twig:Button tag="a" variant="ghost" size="sm" href="{{ path('app_connect_start', {provider: provider, link: 1}) }}">{{ 'settings.link_provider'|trans({'%provider%': provider}) }}</twig:Button>
            {% endfor %}
        </div>
    </twig:Card>

    <twig:Card id="tokens">
        <h2 class="mb-4 text-xl font-semibold">{{ 'settings.tokens'|trans }}</h2>
        {% if newToken %}
            <div id="new-token" class="mb-4 space-y-2">
                <twig:Alert type="success">{{ 'settings.new_token'|trans }}</twig:Alert>
                <code class="block overflow-x-auto rounded-control bg-surface-muted px-3 py-2 text-sm">{{ newToken }}</code>
            </div>
        {% endif %}
        <ul class="mb-4">
            {% for token in tokens %}
                <li class="flex items-center justify-between gap-4 border-b border-line py-2 last:border-0">
                    <span>
                        {{ token.name }}
                        <span class="text-sm text-ink-muted">
                            · {{ 'settings.token_created_on'|trans({'%date%': token.createdAt ~ ' UTC'}) }}
                            · {{ 'settings.token_expires_on'|trans({'%date%': token.expiresAt ~ ' UTC'}) }}
                        </span>
                    </span>
                    <form method="post" action="{{ path('app_settings_token_revoke', {id: token.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('api-token') }}">
                        <twig:Button type="submit" variant="danger" size="sm">{{ 'settings.revoke_token'|trans }}</twig:Button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        <form method="post" action="{{ path('app_settings_token_create') }}" class="flex flex-wrap items-end gap-3">
            <input type="hidden" name="_token" value="{{ csrf_token('api-token') }}">
            <div class="grid gap-1">
                <label for="token-name" class="text-sm font-medium">{{ 'settings.token_name'|trans }}</label>
                <input type="text" id="token-name" name="name" maxlength="100" required class="rounded-control border border-line bg-surface px-3 py-2 focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/30">
            </div>
            <twig:Button type="submit">{{ 'settings.create_token'|trans }}</twig:Button>
        </form>
    </twig:Card>
{% endblock %}
