{% extends 'base.html.twig' %}

{% block body %}
    <h1 class="text-3xl font-bold">{{ 'Plan a marathon'|trans }}</h1>

    {# "Programme updated" notification published by the sync (Task 4), in the language of the page #}
    {{ turbo_stream_from('catalog/' ~ app.request.locale) }}
    <div id="catalog-status"></div>

    <twig:Card>
        {{ form_start(form, {attr: {
            'class': 'grid items-start gap-x-6 sm:grid-cols-2',
            'data-controller': 'geolocation',
            'data-geolocation-unavailable-value': 'Geolocation is not available in this browser.'|trans,
            'data-geolocation-locating-value': 'Locating…'|trans,
            'data-geolocation-saved-value': 'Position saved.'|trans,
            'data-geolocation-denied-value': 'Position denied or unavailable: choose a city.'|trans,
        }}) }}
            {{ form_row(form.date) }}
            <div class="grid grid-cols-2 gap-x-4">
                {{ form_row(form.from) }}
                {{ form_row(form.until) }}
            </div>
            <div>
                {{ form_row(form.city) }}
                <p class="-mt-2 mb-4 flex items-center gap-2 text-sm text-ink-muted">
                    {{ 'or'|trans }}
                    <twig:Button type="button" variant="ghost" size="sm" data-action="geolocation#locate">{{ 'use my position'|trans }}</twig:Button>
                    <span data-geolocation-target="status"></span>
                </p>
            </div>
            {{ form_row(form.travelMode) }}
            {{ form_row(form.films) }}
            {{ form_row(form.version) }}
            <div class="self-center">{{ form_row(form.acceptAds) }}</div>
            <div class="sm:col-span-2">
                <twig:Button type="submit">{{ 'Find my programmes'|trans }}</twig:Button>
            </div>
        {{ form_end(form) }}
    </twig:Card>

    {% if nearbyCinemas is not empty %}
        <twig:Card id="nearby-cinemas">
            {# Closed by default: open it to exclude a cinema, or to reactivate one. #}
            <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-base font-semibold [&::-webkit-details-marker]:hidden">
                    <h2>{{ 'Nearby cinemas (%count%)'|trans({'%count%': nearbyCinemas|length}) }}</h2>
                    <span aria-hidden="true" class="text-ink-muted transition-transform group-open:rotate-180">▾</span>
                </summary>
                <div class="mt-2">
                    <table class="w-full text-sm">
                        <thead class="sr-only">
                            <tr>
                                <th scope="col">{{ 'Cinema'|trans }}</th>
                                <th scope="col">{{ 'Cinema actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line">
                            {% for cinema in nearbyCinemas %}
                                <tr data-nearby-cinema="{{ cinema.slug }}">
                                    <td class="py-2 pr-4">
                                        <span class="font-medium">{{ cinema.name }}</span>
                                        <span class="text-ink-muted">· {{ '%km% km'|trans({'%km%': cinema.distance|format_number({fraction_digit: 1}, locale=app.request.locale)}) }}</span>
                                        {% if usedCinemas[cinema.slug] is defined %}<twig:Badge tone="brand">{{ 'In the programmes'|trans }}</twig:Badge>{% endif %}
                                    </td>
                                    <td class="py-2 text-right">
                                        <twig:ButtonGroup class="button-group-sm" aria-label="{{ 'Cinema actions'|trans }}">
                                            {{ include('excluded/_button.html.twig', {slug: cinema.slug, excluded: cinema.excluded, return_to: app.request.queryString}) }}
                                        </twig:ButtonGroup>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </details>
        </twig:Card>
    {% endif %}

    {% if result is same as(false) %}
        <twig:Alert type="info" class="plan-message">{{ 'No showtime matches this place and date (or you have already seen every film on offer).'|trans }}</twig:Alert>
    {% elseif result %}
        {% if result.reason == 'unknown_location' %}
            <twig:Alert type="error" class="plan-message">{{ 'Unknown place: choose a city from the list or allow geolocation.'|trans }}</twig:Alert>
        {% elseif result.reason == 'no_programme' %}
            <twig:Alert type="info" class="plan-message">{{ 'No programme: no showtime fits these criteria. Try another time range, another version or the ads option.'|trans }}</twig:Alert>
        {% elseif result.reason == 'fewer_films' %}
            {% if result.films == 1 %}
                <twig:Alert type="info" class="plan-message">{{ 'No marathon of %requested% films is possible: here are films on their own.'|trans({'%requested%': form.vars.value.films}) }}</twig:Alert>
            {% else %}
                <twig:Alert type="info" class="plan-message">{{ 'No marathon of %requested% films is possible: here are programmes of %count% films.'|trans({'%requested%': form.vars.value.films, '%count%': result.films}) }}</twig:Alert>
            {% endif %}
        {% elseif result.reason == 'not_enough_programmes' %}
            <twig:Alert type="info" class="plan-message">{{ 'Only %count% programme(s) possible with these criteria.'|trans({'%count%': result.programmes|length}) }}</twig:Alert>
        {% endif %}

        {% if proposedFilms is not empty %}
            <twig:Card id="proposed-films">
                {# Open by default; it can be collapsed to leave room for the programmes. #}
                <details class="group" open>
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-base font-semibold [&::-webkit-details-marker]:hidden">
                        <h2>{{ 'Films in these programmes (%count%)'|trans({'%count%': proposedFilms|length}) }}</h2>
                        <span aria-hidden="true" class="text-ink-muted transition-transform group-open:rotate-180">▾</span>
                    </summary>
                    <div class="mt-2">
                    <table class="w-full text-sm">
                        <thead class="sr-only">
                            <tr>
                                <th scope="col">{{ 'Film'|trans }}</th>
                                <th scope="col">{{ 'Film actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line">
                            {% for film in proposedFilms %}
                                <tr data-proposed-film="{{ film.slug }}">
                                    <td class="py-2 pr-4">
                                        <a href="{{ path('app_film_show', {slug: film.slug}) }}" class="font-medium hover:underline">{{ film.title }}</a>
                                    </td>
                                    <td class="py-2 text-right">
                                        <twig:ButtonGroup class="button-group-sm" aria-label="{{ 'Film actions'|trans }}">
                                            {{ include('seen/_button.html.twig', {slug: film.slug, seen: false, return_to: app.request.queryString}) }}
                                            {{ include('unwanted/_button.html.twig', {slug: film.slug, unwanted: false, return_to: app.request.queryString}) }}
                                        </twig:ButtonGroup>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                </details>
            </twig:Card>
        {% endif %}

        <div class="grid gap-6 lg:grid-cols-3">
            {% for programme in result.programmes %}
                {{ include('home/_programme.html.twig', {programme: programme, number: loop.index}) }}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
