<twig:Card class="programme flex flex-col gap-4">
    <header>
        <h2 class="text-xl font-semibold">{{ 'Programme %number%'|trans({'%number%': number}) }}</h2>
        <p class="text-sm text-ink-muted">
            {{ 'Total wait: %minutes% min'|trans({'%minutes%': programme.wait}) }}
            {% if programme.distance > 0 %} · {{ 'travel: %km% km'|trans({'%km%': programme.distance|format_number({fraction_digit: 1}, locale=app.request.locale)}) }}{% endif %}
        </p>
    </header>
    <ol class="space-y-4">
        {% for showtime in programme.showtimes %}
            {% if not loop.first %}
                <li class="programme-break flex items-center gap-2 pl-3 text-xs text-ink-muted" aria-label="{{ 'Between the two showtimes'|trans }}">
                    <span aria-hidden="true">⏱</span>
                    <span>
                        {{ '%minutes% min break'|trans({'%minutes%': showtime.breakMinutes}) }}
                        {% if showtime.travelMinutes > 0 %} · {{ 'including %minutes% min of travel'|trans({'%minutes%': showtime.travelMinutes}) }}{% endif %}
                    </span>
                </li>
            {% endif %}
            <li class="border-l-2 border-brand-600 pl-3" data-film-slug="{{ showtime.filmSlug }}">
                <p class="text-sm font-semibold text-brand-700">{{ showtime.startTime }} – {{ showtime.endTime }}</p>
                <a href="{{ path('app_film_show', {slug: showtime.filmSlug}) }}" class="font-medium hover:underline">{{ showtime.filmTitle }}</a>
                <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
                    <twig:Badge>{{ showtime.version|upper }}</twig:Badge>
                    {{ showtime.cinemaName }}
                    {% if showtime.lateMinutes > 0 %}<twig:Badge tone="warning">{{ 'arriving during the ads (%minutes% min)'|trans({'%minutes%': showtime.lateMinutes}) }}</twig:Badge>{% endif %}
                </p>
                <twig:Button tag="a" size="sm" data-primary class="mt-2" href="{{ showtime.bookingUrl }}" target="_blank" rel="noopener noreferrer"><twig:Icon name="ticket" />{{ 'Book'|trans }}</twig:Button>
            </li>
        {% endfor %}
    </ol>
</twig:Card>
