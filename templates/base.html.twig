<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Movie Marathon{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
</head>
<body class="min-h-screen">
    <header class="site-header border-b border-line bg-surface">
        <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
            <a href="{{ path('app_home') }}" class="text-lg font-bold text-brand-700">Movie Marathon</a>
            {% if app.user %}
                <nav class="flex items-center gap-4">
                    <a href="{{ path('app_home') }}" class="text-sm font-medium text-ink-muted hover:text-ink">{{ 'Plan'|trans }}</a>
                    <form method="post" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <twig:Button type="submit" variant="secondary" size="sm">{{ 'Log out'|trans }}</twig:Button>
                    </form>
                </nav>
            {% endif %}
        </div>
    </header>
    <main class="mx-auto max-w-5xl space-y-6 px-6 py-8">
        {# Flash messages are translated by the code that adds them. #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}<twig:Alert :type="type">{{ message }}</twig:Alert>{% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</body>
</html>
