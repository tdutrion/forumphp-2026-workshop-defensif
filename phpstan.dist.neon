parameters:
    level: 5
    paths:
        - src
        - tests
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    # Generated by the Symfony skeleton: getAllowedEnvs() is called by the framework, bootstrap is boilerplate.
    excludePaths:
        - tests/bootstrap.php
    ignoreErrors:
        -
            identifier: method.unused
            path: src/Kernel.php
