parameters:
    level: 5
    paths:
        - src
        - tests
    doctrine:
        # v1 style (spec §8): entities keep nullable properties until they are built (exercise 7).
        allowNullablePropertyForRequiredField: true
    exceptions:
        # A failure of the Pathé SDK must be caught or declared: a call that forgets it is reported.
        checkedExceptionClasses:
            - App\Sdk\Pathe\PatheApiException
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    # Generated by the Symfony skeleton: getAllowedEnvs() is called by the framework, bootstrap is boilerplate.
    excludePaths:
        - tests/bootstrap.php
    ignoreErrors:
        -
            identifier: method.unused
            path: src/Kernel.php
        -
            # A test is allowed to let a failure of the SDK fail it.
            identifier: missingType.checkedException
            path: tests/*
        -
            # Test doubles are services of the test environment only; PHPStan reads the dev container.
            identifier: symfonyContainer.serviceNotFound
            path: tests/*
